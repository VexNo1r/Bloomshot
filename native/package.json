{
  "name": "bloomshot-native",
  "version": "0.1.0",
  "private": true,
  "description": "Unreleased BLOOMSHOT native source shell. No billing or signing configured.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepare:web": "node scripts/prepare-web.cjs",
    "sync": "npm run prepare:web && cap sync",
    "sync:android": "npm run prepare:web && cap sync android",
    "sync:ios": "npm run prepare:web && cap sync ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "check": "node scripts/check.cjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@revenuecat/purchases-capacitor": "13.7.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
